{
  "manifest_version": 3,
  "name": "Garmin Peak",
  "description": "Garmin Connect AI Coach",
  "version": "1.0.0",

  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://connect.garmin.com/*",
    "http://localhost:11434/*",
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://connect.garmin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": ["storage", "alarms", "scripting", "tabs"]
}
